# Server dell'app paziente di Nutrea Studio. Copia in .env e compila.

# ——— Database ———
# Due modi:
#  a) dall'app desktop avviata come amministratore (Impostazioni → Amministrazione): lascia DATABASE_URL vuoto
#     e imposta ADMIN_KEY_SHA256 e CONFIG_KEY qui sotto. Il server parte in "modalità configurazione".
#  b) qui, con DB_CLIENT e DATABASE_URL. Una configurazione fatta dall'amministratore ha la precedenza.
# Database: pg (PostgreSQL) | mysql2 (MySQL/MariaDB) | mssql (SQL Server) | better-sqlite3 (file SQLite)
DB_CLIENT=pg
# PostgreSQL:  postgres://utente:password@host:5432/nutrea
# MySQL:       mysql://utente:password@host:3306/nutrea
# SQL Server:  mssql://utente:password@host:1433/nutrea
# SQLite:      percorso del file, es. ./nutrea.sqlite
DATABASE_URL=

# SHA-256 della chiave dello studio: npm run studio-key (la chiave in chiaro va solo nell'app desktop)
STUDIO_KEY_SHA256=

# Amministrazione (configurazione del database dall'app desktop): npm run admin-key genera entrambe le righe.
# ADMIN_KEY_SHA256 abilita la sezione; CONFIG_KEY cifra la configurazione salvata in DATA_DIR/database.json.enc.
ADMIN_KEY_SHA256=
CONFIG_KEY=
DATA_DIR=./data

# Indirizzo pubblico della web app dei pazienti (per i link di attivazione)
WEB_ORIGIN=https://app.diet.it

# Facoltativi
PORT=8080
# Origini ammesse (CORS), separate da virgola; "*" va bene perché l'accesso è con token, senza cookie
CORS_ORIGINS=*
SESSION_DAYS=30
ACTIVATION_DAYS=7
# 0 per non aggiornare le tabelle all'avvio (es. se le crea il DBA con sql/schema.*.sql)
MIGRATE_ON_START=1
# 1 se il server è dietro un proxy (nginx, Caddy…): serve per il limite di tentativi per IP
TRUST_PROXY=0

# MySQL gestito (es. Aiven): DB_CLIENT si ricava dall'indirizzo mysql://. Il certificato CA del servizio va in un file .pem.
# DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# DB_SSL_CA=./aiven-ca.pem
