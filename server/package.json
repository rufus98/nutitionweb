{
  "name": "nutrea-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Server dell'app paziente di Nutrea Studio: riceve i dati dallo studio e li serve ai pazienti (link personale + password).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/cli.ts migrate",
    "studio-key": "tsx src/cli.ts studio-key",
    "schema-sql": "tsx src/cli.ts schema-sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "knex": "^3.1.0",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "tedious": "^18.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
