{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nutrea Studio",
  "version": "1.0.0",
  "identifier": "it.nutrea.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nutrea Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 760,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=it-IT"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; frame-src 'self' blob:; object-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "category": "Business",
    "shortDescription": "Gestionale per studi di nutrizione",
    "longDescription": "Pazienti, visite, misure, piani nutrizionali, agenda e pagamenti per lo studio del nutrizionista.",
    "copyright": "© 2026 Nutrea Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "it-IT"
      },
      "nsis": {
        "languages": [
          "Italian"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
